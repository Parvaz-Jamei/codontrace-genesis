include README.md
include LICENSE
include CHANGELOG.md
include SECURITY.md
include CONTRIBUTING.md
include RELEASE_EVIDENCE.md
include CITATION.cff
include pyproject.toml
recursive-include docs *.md
recursive-include docs/hard_experiment_01 *.json
recursive-include docs/hard_experiment_02 *.json
recursive-include docs/hard_experiment_03 *.json
recursive-include src/codontrace/genesis/rag/corpus *.jsonl
recursive-include src/codontrace/genesis/rag/corpus *.md
include src/codontrace/genesis/ilw/INTEGRATION_DAG.json
recursive-include examples *.py
recursive-include tests *.py
recursive-include tools *.py
recursive-include .github/workflows *.yml
recursive-include .github/workflows *.yaml
prune artifacts
prune reports
prune build
prune dist
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
global-exclude .pytest_cache
global-exclude .mypy_cache
global-exclude .ruff_cache
global-exclude *.html
global-exclude *.patch
global-exclude .grok_write_probe*.txt
global-exclude .size_test_*.txt
